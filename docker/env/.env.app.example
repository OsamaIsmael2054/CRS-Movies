# App settings for the containerized API (copy to .env.app).
# Inside the compose network the app reaches Postgres by service name on the
# container's internal port (5432), and Ollama on the host via host.docker.internal.
POSTGRES_HOST=postgres
POSTGRES_HOST_PORT=5432

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:12b

# Host port the API container is published on.
APP_HOST_PORT=8000
